# Pl@ntNet API (Free tier account required: https://my.plantnet.org/)
# Keep this value strictly on the server. Never prefix with VITE_.
PLANTNET_API_KEY="your_private_plantnet_api_key"
PLANTNET_API_BASE_URL="https://my-api.plantnet.org"

# GBIF Public Taxonomy API (No API key required)
GBIF_API_BASE_URL="https://api.gbif.org"

# Allowed CORS origins (comma-separated) for standalone backend deployments
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Upload limits
MAX_IMAGES_PER_SCAN="5"
MAX_IMAGE_SIZE_MB="10"
MAX_TOTAL_UPLOAD_MB="25"

# Application URL
APP_URL="http://localhost:3000"
